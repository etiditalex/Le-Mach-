# Copy this file to .env.local and fill in values. Restart "npm run dev" after any change.
# No spaces around "=" (wrong: KEY= value — right: KEY=value).

# Production: your canonical URL (Open Graph, favicon resolution, use https://)
# NEXT_PUBLIC_SITE_URL is preferred for Daraja callback URL resolution.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy alias still supported:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# service_role secret (long eyJ... JWT OR sb_secret_...). NOT the anon key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Optional: restrict /admin to these emails (comma-separated, no spaces).
# ADMIN_EMAILS=admin@yourhotel.com

# Optional: replace the built-in default signage video (query ?youtube= or ?v= still wins)
# Built-in: https://youtu.be/vus8_xcZ2Ok
# NEXT_PUBLIC_SIGNAGE_YOUTUBE=https://youtu.be/OTHER_VIDEO_ID

# Digital signage — in-page YouTube music search (server-only). Enable "YouTube Data API v3" in Google Cloud.
# YOUTUBE_DATA_API_KEY=your_youtube_data_api_key

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Optional PartyB override (defaults to MPESA_SHORTCODE)
# MPESA_PARTY_B=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional when NEXT_PUBLIC_SITE_URL/NEXT_PUBLIC_APP_URL/VERCEL_URL is set; explicit value takes precedence.
MPESA_CALLBACK_URL=http://localhost:3000/api/daraja/callback
# Optional protection for /api/payments/mpesa/diagnose endpoint (recommended in production).
# Send this value as header x-mpesa-diagnostics-token when calling diagnose endpoint.
# MPESA_DIAGNOSTICS_TOKEN=replace_with_random_long_string

# Optional explicit Daraja endpoint overrides (matches older project style).
# If set, these take precedence over MPESA_ENV/base URL behavior.
# MPESA_BASE_URL=https://api.safaricom.co.ke
# MPESA_OAUTH_URL=https://api.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
# MPESA_STKPUSH_URL=https://api.safaricom.co.ke/mpesa/stkpush/v1/processrequest
# MPESA_STKPUSH_QUERY_URL=https://api.safaricom.co.ke/mpesa/stkpushquery/v1/query
# (legacy aliases also supported: MPESA_STK_PUSH_URL, MPESA_STK_QUERY_URL)

# M-Pesa Daraja B2C (optional module: payouts/refunds, separate from STK checkout)
# Protect B2C endpoints by sending this header: x-mpesa-b2c-token
# MPESA_B2C_API_TOKEN=replace_with_random_long_string
# MPESA_B2C_INITIATOR_NAME=api_initiator_username
# MPESA_B2C_SECURITY_CREDENTIAL=encrypted_initiator_password_from_safaricom
# MPESA_B2C_COMMAND_ID=BusinessPayment
# Optional callback overrides (otherwise NEXT_PUBLIC_APP_URL/VERCEL_URL fallback is used):
# MPESA_B2C_RESULT_URL=https://your-domain.com/api/webhooks/mpesa/b2c/result
# MPESA_B2C_TIMEOUT_URL=https://your-domain.com/api/webhooks/mpesa/b2c/timeout
# Optional endpoint overrides (from Daraja portal):
# MPESA_B2C_URL=https://api.safaricom.co.ke/mpesa/b2c/v1/paymentrequest
# MPESA_TRANSACTION_STATUS_URL=https://api.safaricom.co.ke/mpesa/transactionstatus/v1/query
# MPESA_ACCOUNT_BALANCE_URL=https://api.safaricom.co.ke/mpesa/accountbalance/v1/query
